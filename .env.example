# ============================================================
# CONFIGURAÇÃO DO CONCURSO — make_apostila_concurso
# Copie este arquivo para .env e preencha com os dados reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# ============================================================

# ------------------------------------------------------------
# IDENTIFICAÇÃO DO CONCURSO
# ------------------------------------------------------------

# Nome completo do concurso
CONCURSO_NOME="Concurso Público para Analista Judiciário do TRT-X"

# Órgão contratante
CONCURSO_ORGAO="Tribunal Regional do Trabalho da X Região"

# Sigla do órgão (usada em nomes de arquivo e títulos)
CONCURSO_ORGAO_SIGLA="TRT-X"

# Cargo(s) alvo — pode listar mais de um separado por vírgula
CONCURSO_CARGO="Analista Judiciário — Área Administrativa"

# Esfera (federal | estadual | municipal | distrital)
CONCURSO_ESFERA="federal"

# Área / eixo temático (se for concurso por blocos como CNU)
CONCURSO_EIXO=""

# Nível de escolaridade exigido (superior | médio | fundamental)
CONCURSO_NIVEL="superior"

# Número do edital
CONCURSO_EDITAL_NUMERO="001/2026"

# Ano do edital / concurso
CONCURSO_ANO="2026"

# ------------------------------------------------------------
# EDITAL — FONTE
# (preencha APENAS uma das opções abaixo)
# ------------------------------------------------------------

# Opção A: URL web do edital (PDF ou página oficial)
EDITAL_URL="https://www.banca.com.br/concurso/edital-001-2026.pdf"

# Opção B: Caminho local do arquivo (se já baixou o PDF)
EDITAL_ARQUIVO_LOCAL=""
# Exemplo: EDITAL_ARQUIVO_LOCAL="/home/usuario/Downloads/edital_trt.pdf"

# Status do edital:
#   publicado    → edital já saiu (preencha URL ou arquivo acima)
#   previsto     → concurso previsto mas edital ainda não publicado
#   retificado   → houve retificação (preencha também EDITAL_RETIFICACAO_URL)
EDITAL_STATUS="publicado"

# URL da retificação (se houver)
EDITAL_RETIFICACAO_URL=""

# Data-limite de vigência da legislação exigida pelo edital
# (ex.: "legislação vigente até a data de publicação do edital")
# Formato: YYYY-MM-DD. Deixe vazio para usar a data atual.
EDITAL_DATA_LIMITE_LEGISLACAO="2026-01-15"

# ------------------------------------------------------------
# BANCA ORGANIZADORA
# Bancas suportadas: CEBRASPE | FGV | FCC | VUNESP | CESGRANRIO
#                   IBFC | IDECAN | AOCP | FEPESE | CONSULPLAN
#                   OUTRO
# ------------------------------------------------------------

BANCA_NOME="CEBRASPE"

# Formato principal da prova objetiva:
#   certo_errado  → itens de julgamento com penalização (CEBRASPE clássico)
#   multipla_escolha_4 → 4 alternativas
#   multipla_escolha_5 → 5 alternativas (FCC, FGV, VUNESP)
BANCA_FORMATO_OBJETIVO="certo_errado"

# A prova objetiva tem penalização por erro? (true | false)
BANCA_PENALIZACAO="true"

# Há prova discursiva / redação? (true | false)
BANCA_DISCURSIVA="true"

# Há prova prática, TAF, avaliação psicológica, etc.? (true | false)
BANCA_ETAPAS_EXTRAS="false"

# ------------------------------------------------------------
# CONFIGURAÇÃO DA APOSTILA
# ------------------------------------------------------------

# Idioma do conteúdo (pt-BR é o padrão)
APOSTILA_IDIOMA="pt-BR"

# Nível de profundidade preferido:
#   basico     → conceitos essenciais + questões diretas
#   intermediario → teoria completa + jurisprudência + questões
#   avancado   → verticalização máxima + análise de distratores + TRI
APOSTILA_PROFUNDIDADE="intermediario"

# Incluir seção de jurisprudência em disciplinas jurídicas? (true | false)
APOSTILA_INCLUIR_JURISPRUDENCIA="true"

# Incluir mapas mentais (estrutura + Mermaid)? (true | false)
APOSTILA_INCLUIR_MAPA_MENTAL="true"

# Incluir flashcards exportáveis (CSV para Anki)? (true | false)
APOSTILA_INCLUIR_FLASHCARDS="true"

# Incluir simulado final? (true | false)
APOSTILA_INCLUIR_SIMULADO="true"

# Número mínimo de questões por tópico (além das de provas anteriores)
APOSTILA_QUESTOES_MIN_POR_TOPICO="5"

# ------------------------------------------------------------
# MODO PRÉ-EDITAL
# (ativo quando EDITAL_STATUS=previsto)
# ------------------------------------------------------------

# Concursos anteriores do mesmo órgão/cargo para usar como base
# (URLs ou caminhos locais, separados por vírgula)
PRE_EDITAL_EDITAIS_ANTERIORES=""

# Órgãos análogos para inferência de conteúdo (siglas separadas por vírgula)
PRE_EDITAL_ORGAOS_ANALOGOS="TRT-1,TRT-2,TRT-3"

# O material pré-edital deve ser marcado como provisório? (true | false)
PRE_EDITAL_MARCAR_PROVISORIO="true"

# ------------------------------------------------------------
# CONFIGURAÇÕES AVANÇADAS (opcional)
# ------------------------------------------------------------

# Diretório de saída da apostila gerada (relativo à raiz do projeto)
OUTPUT_DIR="apostila_gerada"

# Formato(s) de exportação: md | pdf | epub | docx (separados por vírgula)
# md  → Markdown puro (base; sempre gerado)
# pdf → PDF via Pandoc + LaTeX (requer pandoc e texlive instalados)
# epub→ EPUB via Pandoc (requer pandoc instalado)
OUTPUT_FORMATOS="md,pdf,epub"

# Diretório onde os arquivos PDF e EPUB finais serão salvos
# (ignorado pelo git — não commitar)
OUTPUT_PUBLICADO_DIR="apostila_publicada"

# Habilitar modo verbose (logs detalhados do pipeline)? (true | false)
VERBOSE="false"
